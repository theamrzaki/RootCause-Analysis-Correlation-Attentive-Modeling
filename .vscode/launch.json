    "version": "0.2.0",
    "configurations": [
        {
            "name": "vlinear",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "args": [
                "--encoder_gamma", "0.5",
                "--decoder_gamma", "0.5",
                "--encoder_lambda", "0.5",
                "--decoder_lambda", "0.5",
                "--beta", "0.005",

                "--main_model", "aerca_based",
                "--coeff_architecture", "vlinear",
                "--temporal_mixer", "1",
                "--use_MoM", "0",

                "--preprocessing_data", "0",

                "--lr", "1e-4",
                "--seed", "1",
                "--dataset", "swat",
                "--window_size", "64",

                "--latent_mode", "mul",
                "--context", "linear_attn",
                "--pool", "max",
                "--coeff_mode", "symmetric",
                "--predictor", "linear",

                "--training_aerca", "0",
                "--epochs", "200",
                "--results_csv", "RQ_1_SWAT_ExpandedWindows.csv",

                "--hidden_layer_size", "128"
            ],
        "console": "integratedTerminal"
    },
        {
            "name": "Run Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}