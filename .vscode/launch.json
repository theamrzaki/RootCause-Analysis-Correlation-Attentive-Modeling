    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug Main",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "args": [
                "--seed","1",
                "--dataset_name", "msds",
                "--lr","1e-4",
                "--window_size","10",
                "--coeff_architecture","TemporalGNN_Attention_crossattn",
                "--num_attention_heads","2",
                "--attention_dim","256",
                "--outer_heads_num","2",
                "--outer_hidden_dim","256",
                "--correlated_KL","0",
                "--AMOC_Loss","0",
                "--mean_std_recon_loss","0"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "run Main",
            "type": "python",
            "request": "launch",
            "program": "main.py",
            "args": [
                "--dataset_name", "msds"
            ],
            "console": "integratedTerminal",
            "noDebug": true
        },
        {
            "name": "Run Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}