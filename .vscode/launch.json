    "version": "0.2.0",
    "configurations": [
        {
            "name": "vlinear",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "args": [
                "--encoder_alpha", "1.0",
                "--decoder_alpha", "1.0",
                "--encoder_gamma", "0.2",
                "--decoder_gamma", "0.2",
                "--encoder_lambda", "0.5",
                "--decoder_lambda", "0.5",
                "--beta", "0.01",

                "--main_model", "aerca_based",
                "--coeff_architecture", "baro",
                "--time_freq_representation", "baro",

                "--lr", "1e-4",
                "--seed", "7",
                "--dataset", "smd",
                "--window_size", "4",
                "--temporal_mixer","0",
                "--use_MoM","LinearRNNMoM",

                "--training_aerca", "0",
                "--epochs", "20",
                "--preprocessing_data", "0",
                "--include_logs_and_traces", "0",
                "--results_csv", "testing.csv",

                "--run_case_study", "1",
                "--hidden_layer_size", "128"
            ],
        "console": "integratedTerminal"
    },
        {
            "name": "Run Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}